FROM python:3.11-slim

WORKDIR /app

COPY pyproject.toml .
RUN pip install --no-cache-dir fastapi uvicorn telethon sqlalchemy asyncpg psycopg2-binary alembic pydantic pydantic-settings

COPY apps ./apps
COPY shared ./shared

CMD ["uvicorn", "apps.api.main:app", "--host", "0.0.0.0", "--port", "8000"]